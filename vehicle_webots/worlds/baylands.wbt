DEF tesla TeslaModel3 {
  translation 0 0 0.0
  rotation 0 0 1 0
  name "tesla"
  controller "<extern>"
  window "<none>"
  supervisor TRUE

  sensorsSlotFront [
    Camera {
          name "camera"
          translation -2.12 0 0.93
          rotation 0 1 0 0.175
          fieldOfView 0.45
          width 128
          height 96
          
          recognition Recognition {
            maxRange 15
            segmentation TRUE
          }
    }
  ]

  sensorsSlotCenter [
    InertialUnit { name "imu" }
    Gyro { name "gyro" }
    Accelerometer { name "accel" }
    Compass { name "mag" }
  ]

  sensorsSlotTop [
    GPS { 
      name "gps" 
      accuracy 1.5
    }
  ]
}

# ── SpeedBump Supervisor (ROS2) ─────────────────────────────
DEF speedbump_controller Robot {
  translation 0 0 0
  name "speedbump_supervisor"
  controller "SpeedBumpSupervisor"
  supervisor TRUE
  window "<none>"
}